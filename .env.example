# 复制为 .env 并填写。密钥只保存在本文件，不会发送到前端。

PORT=8787

# 快速模型：用于实时提词（要求低延迟）
FAST_BASE_URL=https://api.deepseek.com/v1
FAST_API_KEY=
FAST_MODEL=deepseek-chat
# 推理模型（如 deepseek-flash / deepseek-v4-pro）建议设为 low，减少思考、降低延迟；
# 非推理模型请留空或删除该行
# FAST_EFFORT=low

# 强模型：用于章节摘要、全书梗概、人物状态更新、手动续写
STRONG_BASE_URL=https://api.deepseek.com/v1
STRONG_API_KEY=
STRONG_MODEL=deepseek-chat
# STRONG_EFFORT=low

# 本地模型示例（Ollama，无需真实密钥）：
# FAST_BASE_URL=http://127.0.0.1:11434/v1
# FAST_API_KEY=ollama
# FAST_MODEL=qwen2.5:7b
# STRONG_BASE_URL=http://127.0.0.1:11434/v1
# STRONG_API_KEY=ollama
# STRONG_MODEL=qwen2.5:14b
