{
  "name": "@writerai/app",
  "version": "0.1.0",
  "private": true,
  "description": "WriterAI 桌面版外壳（Electron，仅做窗口 + 拉起本地后端）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dmg": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.writerai.app",
    "productName": "WriterAI",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  }
}
