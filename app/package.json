{
  "name": "@writerai/app",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "description": "WriterAI 桌面版（Electron 壳 + 本地后端）",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir",
    "dmg": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.writerai.app",
    "productName": "WriterAI",
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
